load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@generate_parameter_library//:defs.bzl", "generate_parameter_library")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

CPP_DEPENDENCIES = {
    "@controller_interface//:controller_interface": "@controller_interface//:controller_interface_library",
    "@diagnostic_updater//:diagnostic_updater": "@diagnostic_updater//:diagnostic_updater_library",
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@libstatistics_collector//:libstatistics_collector": "@libstatistics_collector//:libstatistics_collector_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
}

generate_parameter_library(
    name = "controller_manager_parameters",
    yaml_file = "src/controller_manager_parameters.yaml",
)

py_binary(
    name = "spawner",
    srcs = [
        "controller_manager/__init__.py",
        "controller_manager/controller_manager_services.py",
        "controller_manager/spawner.py",
    ],
    imports = ["."],
    deps = [
        "@controller_manager_msgs//:py",
        "@lifecycle_msgs//:py",
        "@rclpy",
        requirement("filelock"),
    ],
)

py_binary(
    name = "unspawner",
    srcs = [
        "controller_manager/controller_manager_services.py",
        "controller_manager/unspawner.py",
    ],
    deps = ["@controller_manager_msgs//:py"],
)

py_binary(
    name = "hardware_spawner",
    srcs = [
        "controller_manager/controller_manager_services.py",
        "controller_manager/hardware_spawner.py",
    ],
    deps = ["@controller_manager_msgs//:py"],
)

cc_library(
    name = "controller_manager_library",
    srcs = [
        "src/controller_manager.cpp",
    ],
    hdrs = HEADERS,
    deps = CPP_DEPENDENCIES.values() + [
        ":controller_manager_parameters",
        "@controller_manager_msgs//:cc",
        "@libcap//:cap",
    ],
)

cc_shared_library(
    name = "controller_manager",
    exports_filter = [":controller_manager_library"],
    deps = [
        ":controller_manager_library",
    ],
)

cc_binary(
    name = "ros2_control_node",
    srcs = [
        "src/ros2_control_node.cpp",
    ],
    linkopts = ["-rdynamic"],
    deps = [
        ":controller_manager_library",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = [
        ":controller_manager_parameters",
    ],
    executables = [
        ":controller_manager",
        ":ros2_control_node",
        ":spawner",
        ":unspawner",
        ":hardware_spawner",
    ],
    headers = HEADERS,
    libraries = [
        ":controller_manager_library",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@backward_ros//:ament_package",
        "@controller_interface//:ament_package",
        "@controller_manager_msgs//:ament_package",
        "@diagnostic_updater//:ament_package",
        "@example_interfaces//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@hardware_interface//:ament_package",
        "@hardware_interface_testing//:ament_package",
        "@launch//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing//:ament_package",
        "@launch_testing_ros//:ament_package",
        "@libstatistics_collector//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@pluginlib//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rclpy//:ament_package",
        "@realtime_tools//:ament_package",
        "@robot_state_publisher//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@ros2param//:ament_package",
        "@ros2pkg//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@urdf//:ament_package",
    ],
)
