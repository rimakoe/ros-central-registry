load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

CPP_DEPENDENCIES = {
    "@pal_statistics//:pal_statistics": "@pal_statistics//:pal_statistics_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@rosdistro//cc:tinyxml2": "@rosdistro//cc:tinyxml2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

cc_library(
    name = "hardware_interface_library",
    srcs = [
        "src/component_parser.cpp",
        "src/hardware_component.cpp",
        "src/hardware_component_interface.cpp",
        "src/lexical_casts.cpp",
        "src/resource_manager.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = CPP_DEPENDENCIES.values() + [
        "@control_msgs//:cc",
        "@joint_limits//:joint_saturation_limiter_library",
        "@lifecycle_msgs//:cc",
    ],
)

cc_shared_library(
    name = "hardware_interface",
    exports_filter = [":hardware_interface_library"],
    deps = [":hardware_interface_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    lib_data = [":hardware_interface"],
    libraries = [
        ":hardware_interface_library",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@control_msgs//:ament_package",
        "@joint_limits//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@pal_statistics//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@ros2_control_test_assets//:ament_package",
        "@rosdistro//:ament_package",
        "@sdformat_urdf//:ament_package",
        "@urdf//:ament_package",
    ],
)
