load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

CPP_DEPENDENCIES = {
    "@hardware_interface//:hardware_interface": "@hardware_interface//:hardware_interface_library",
    "@pal_statistics//:pal_statistics": "@pal_statistics//:pal_statistics_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
}

cc_library(
    name = "controller_interface_library",
    srcs = [
        "src/chainable_controller_interface.cpp",
        "src/controller_interface.cpp",
        "src/controller_interface_base.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = CPP_DEPENDENCIES.values(),
)

cc_shared_library(
    name = "controller_interface",
    exports_filter = [":controller_interface_library"],
    visibility = ["//visibility:public"],
    deps = [":controller_interface_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    lib_data = [":controller_interface"],
    libraries = [
        ":controller_interface_library",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@geometry_msgs//:ament_package",
        "@hardware_interface//:ament_package",
        "@pal_statistics//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
