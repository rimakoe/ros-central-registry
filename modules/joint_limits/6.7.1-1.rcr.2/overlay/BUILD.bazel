load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

CPP_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
    "@realtime_tools//:realtime_tools": "@realtime_tools//:realtime_tools_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
}

cc_library(
    name = "joint_limits_library",
    hdrs = HEADERS,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = CPP_DEPENDENCIES.values(),
)

cc_library(
    name = "joint_limiter_interface_library",
    srcs = ["src/joint_limiter_interface.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":joint_limits_library",
        "@trajectory_msgs//:cc",
    ],
)

cc_shared_library(
    name = "joint_limiter_interface",
    exports_filter = [":joint_limiter_interface_library"],
    deps = [":joint_limiter_interface_library"],
)

cc_library(
    name = "joint_limits_helpers_library",
    srcs = ["src/joint_limits_helpers.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    deps = [":joint_limits_library"],
)

cc_shared_library(
    name = "joint_limits_helpers",
    exports_filter = [":joint_limits_helpers_library"],
    deps = [":joint_limits_helpers_library"],
)

cc_library(
    name = "joint_saturation_limiter_library",
    srcs = [
        "src/joint_range_limiter.cpp",
        "src/joint_saturation_limiter.cpp",
        "src/joint_soft_limiter.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        ":joint_limiter_interface_library",
        ":joint_limits_helpers_library",
    ],
)

cc_shared_library(
    name = "joint_saturation_limiter",
    exports_filter = [":joint_saturation_limiter_library"],
    deps = [":joint_saturation_limiter_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    lib_data = [
        ":joint_limiter_interface",
        ":joint_limits_helpers",
        ":joint_saturation_limiter",
    ],
    libraries = [
        ":joint_limiter_interface_library",
        ":joint_limits_helpers_library",
        ":joint_saturation_limiter_library",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@backward_ros//:ament_package",
        "@generate_parameter_library//:ament_package",
        "@launch_ros//:ament_package",
        "@launch_testing_ament_cmake//:ament_package",
        "@pluginlib//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@realtime_tools//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@trajectory_msgs//:ament_package",
        "@urdf//:ament_package",
    ],
)
