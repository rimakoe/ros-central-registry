load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

COMMON_DEPS = [
    "@rclcpp//:rclcpp_library",
    "@rclcpp_action//:rclcpp_action_library",
    "@rcpputils//:rcpputils_library",
    "@libcap//:cap",
]

cc_library(
    name = "realtime_tools_library",
    srcs = ["src/realtime_helpers.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    deps = COMMON_DEPS + [
        "@rosdistro//cc:boost.lockfree",
    ],
)

cc_shared_library(
    name = "realtime_tools",
    exports_filter = [":realtime_tools_library"],
    deps = [":realtime_tools_library"],
)

cc_library(
    name = "thread_priority_library",
    srcs = ["src/realtime_helpers.cpp"],
    hdrs = HEADERS,
    includes = ["include"],
    deps = COMMON_DEPS,
)

cc_shared_library(
    name = "thread_priority",
    exports_filter = [":thread_priority_library"],
    deps = [":thread_priority_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    lib_data = [
        ":realtime_tools",
        ":thread_priority",
    ],
    libraries = [
        ":realtime_tools_library",
        ":thread_priority_library",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_gmock//:ament_package",
        "@lifecycle_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_action//:ament_package",
        "@rclcpp_lifecycle//:ament_package",
        "@ros2_control_cmake//:ament_package",
        "@rosdistro//:ament_package",
        "@test_msgs//:ament_package",
    ],
)
