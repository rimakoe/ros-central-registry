module(
    name = "rules_ros2",
    version = "1.0.0",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "aspect_rules_py", version = "1.11.7")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rosdistro", version = "lyrical.2026-06-08.rcr.10")
bazel_dep(name = "rclpy", version = "0.0.0")
bazel_dep(name = "launch", version = "3.9.7-3.rcr.1")
bazel_dep(name = "launch_ros", version = "0.29.8-1.rcr.1")
bazel_dep(name = "lifecycle_msgs", version = "2.4.5-1.rcr.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")
